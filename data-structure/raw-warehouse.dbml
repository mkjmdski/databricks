Table "fact_rental" {
  "rental_key" bigint [pk, not null]
  "rental_id" int(10) [not null]
  "customer_key" bigint [not null]
  "car_key" bigint [not null]
  "staff_key" bigint [not null]
  "store_key" bigint [not null]
  "rental_date_key" bigint [not null]
  "return_date_key" bigint
  "payment_date_key" bigint
  "payment_deadline_date_key" bigint [not null]
  "rental_date" date [not null]
  "rental_amount" decimal(12,2)
  "payment_amount" decimal(12,2)
  "rental_rate" decimal(12,2) [not null]
  "rental_duration" int(5)
  "payment_delay_duration" int(5)

  Indexes {
    rental_id [name: "fact_rental_business_key_IDX", unique]
    customer_key [name: "fact_rental_customer_IDX"]
    car_key [name: "fact_rental_car_IDX"]
    staff_key [name: "fact_rental_staff_IDX"]
    store_key [name: "fact_rental_store_IDX"]
    rental_date [name: "fact_rental_rental_date_IDX"]
  }
}

Table "fact_service" {
  "service_key" bigint [pk, not null]
  "service_id" int(10) [not null]
  "car_key" bigint [not null]
  "service_date_key" bigint [not null]
  "service_date" date [not null]
  "service_type" varchar(100) [not null]
  "service_cost" decimal(18,4) [not null]

  Indexes {
    service_id [name: "fact_service_business_key_IDX", unique]
    car_key [name: "fact_service_car_IDX"]
    service_date_key [name: "fact_service_service_date_key_IDX"]
    service_date [name: "fact_service_date_IDX"]
  }
}

Table "dim_customer" {
  "customer_key" bigint [pk, not null]
  "customer_id" int(10) [not null]
  "customer_first_name" varchar(50)
  "customer_last_name" varchar(50)
  "customer_email" varchar(50)
  "birth_date" date
  "customer_address" varchar(150)
  "customer_city" varchar(50)
  "customer_country" varchar(50)

  Indexes {
    customer_id [name: "dim_customer_business_key_IDX", unique]
  }
}

Table "dim_car" {
  "car_key" bigint [pk, not null]
  "car_id" int(10)
  "inventory_id" int(10) [not null]
  "producer" varchar(50)
  "model" varchar(50)
  "rental_rate" decimal(12,2)
  "production_year" int(4)
  "fuel_type" varchar(15)
  "license_plates" varchar(10)
  "purchase_price" decimal(18,2)
  "sell_price" decimal(18,2)
  "store_id" int(10)
  "last_update" datetime

  Indexes {
    inventory_id [name: "dim_car_business_key_IDX", unique]
    car_id [name: "dim_car_car_id_IDX"]
    producer [name: "dim_car_producer_IDX"]
    store_id [name: "dim_car_store_id_IDX"]
  }
}

Table "dim_staff" {
  "staff_key" bigint [pk, not null]
  "staff_id" int(10) [not null]
  "store_id" int(10)
  "staff_first_name" varchar(50)
  "staff_last_name" varchar(50)
  "staff_email" varchar(50)
  "hired_date" date
  "staff_address" varchar(150)
  "staff_city" varchar(50)
  "staff_country" varchar(50)
  "staff_manager_first_name" varchar(50)
  "staff_manager_last_name" varchar(50)

  Indexes {
    staff_id [name: "dim_staff_business_key_IDX", unique]
    store_id [name: "dim_staff_store_id_IDX"]
  }
}

Table "dim_manager" {
  "manager_key" bigint [pk, not null]
  "staff_id" int(10) [not null]
  "store_id" int(10)
  "manager_first_name" varchar(50)
  "manager_last_name" varchar(50)
  "manager_email" varchar(50)
  "hired_date" date
  "manager_address" varchar(150)
  "manager_city" varchar(50)
  "manager_country" varchar(50)
  "manager_manager_first_name" varchar(50)
  "manager_manager_last_name" varchar(50)

  Indexes {
    staff_id [name: "dim_manager_business_key_IDX", unique]
    store_id [name: "dim_manager_store_id_IDX"]
  }
}

Table "dim_store" {
  "store_key" bigint [pk, not null]
  "store_id" int(10) [not null]
  "manager_id" int(10)
  "store_manager_first_name" varchar(50)
  "store_manager_last_name" varchar(50)
  "store_address" varchar(150)
  "city" varchar(50) [not null]
  "country" varchar(50) [not null]
  "postal_code" varchar(10)
  "last_update" datetime [not null]
  "effective_date" datetime [not null]
  "end_date" datetime
  "is_current" boolean [not null, default: true]

  Indexes {
    store_id [name: "dim_store_business_key_IDX"]
    (store_id, is_current) [name: "dim_store_current_IDX"]
    city [name: "dim_store_city_IDX"]
    country [name: "dim_store_country_IDX"]
  }
}

Table "dim_date" {
  "date_key" bigint [pk, not null]
  "date" date [not null, unique]
  "day_of_week" int(1)
  "day_of_week_name" varchar(10)
  "day_of_month" int(2)
  "week_of_year" int(2)
  "month" int(2)
  "month_name" varchar(10)
  "quarter" int(1)
  "year" int(4)
  "is_weekend" boolean [not null]
  "is_pre_covid" boolean [not null]
  "is_covid" boolean [not null]
  "is_post_covid" boolean [not null]

  Indexes {
    date [name: "dim_date_date_IDX", unique]
    (year, month) [name: "dim_date_year_month_IDX"]
    (year, quarter) [name: "dim_date_year_quarter_IDX"]
  }
}

Table "dim_service_date" {
  "service_date_key" bigint [pk, not null]
  "service_date" date [not null, unique]
  "day_of_week" int(1)
  "day_of_week_name" varchar(10)
  "day_of_month" int(2)
  "week_of_year" int(2)
  "month" int(2)
  "month_name" varchar(10)
  "quarter" int(1)
  "year" int(4)
  "is_weekend" boolean [not null]
  "is_pre_covid" boolean [not null]
  "is_covid" boolean [not null]
  "is_post_covid" boolean [not null]

  Indexes {
    service_date [name: "dim_service_date_date_IDX", unique]
  }
}

Table "dim_rental_date" {
  "rental_date_key" bigint [pk, not null]
  "rental_date" date [not null, unique]
  "day_of_week" int(1)
  "day_of_week_name" varchar(10)
  "day_of_month" int(2)
  "week_of_year" int(2)
  "month" int(2)
  "month_name" varchar(10)
  "quarter" int(1)
  "year" int(4)
  "is_weekend" boolean [not null]
  "is_pre_covid" boolean [not null]
  "is_covid" boolean [not null]
  "is_post_covid" boolean [not null]

  Indexes {
    rental_date [name: "dim_rental_date_date_IDX", unique]
  }
}

Table "dim_return_date" {
  "return_date_key" bigint [pk, not null]
  "return_date" date [not null, unique]
  "day_of_week" int(1)
  "day_of_week_name" varchar(10)
  "day_of_month" int(2)
  "week_of_year" int(2)
  "month" int(2)
  "month_name" varchar(10)
  "quarter" int(1)
  "year" int(4)
  "is_weekend" boolean [not null]
  "is_pre_covid" boolean [not null]
  "is_covid" boolean [not null]
  "is_post_covid" boolean [not null]

  Indexes {
    return_date [name: "dim_return_date_date_IDX", unique]
  }
}

Table "dim_payment_date" {
  "payment_date_key" bigint [pk, not null]
  "payment_date" date [not null, unique]
  "day_of_week" int(1)
  "day_of_week_name" varchar(10)
  "day_of_month" int(2)
  "week_of_year" int(2)
  "month" int(2)
  "month_name" varchar(10)
  "quarter" int(1)
  "year" int(4)
  "is_weekend" boolean [not null]
  "is_pre_covid" boolean [not null]
  "is_covid" boolean [not null]
  "is_post_covid" boolean [not null]

  Indexes {
    payment_date [name: "dim_payment_date_date_IDX", unique]
  }
}

Table "dim_payment_deadline_date" {
  "payment_deadline_date_key" bigint [pk, not null]
  "payment_deadline_date" date [not null, unique]
  "day_of_week" int(1)
  "day_of_week_name" varchar(10)
  "day_of_month" int(2)
  "week_of_year" int(2)
  "month" int(2)
  "month_name" varchar(10)
  "quarter" int(1)
  "year" int(4)
  "is_weekend" boolean [not null]
  "is_pre_covid" boolean [not null]
  "is_covid" boolean [not null]
  "is_post_covid" boolean [not null]

  Indexes {
    payment_deadline_date [name: "dim_payment_deadline_date_date_IDX", unique]
  }
}

Table "dim_equipment" {
  "equipment_key" bigint [pk, not null]
  "equipment_id" int(10) [not null]
  "name" varchar(50) [not null]
  "type" varchar(50)
  "version" varchar(50)

  Indexes {
    equipment_id [name: "dim_equipment_business_key_IDX", unique]
    type [name: "dim_equipment_type_IDX"]
  }
}

Table "bridge_equipment_group_equipment" {
  "equipment_group_key" bigint [not null]
  "equipment_key" bigint [not null]

  Indexes {
    (equipment_group_key, equipment_key) [pk, name: "bridge_equipment_group_equipment_PK"]
    equipment_group_key [name: "bridge_equipment_group_IDX"]
    equipment_key [name: "bridge_equipment_IDX"]
  }
}

Table "bridge_staff_hierarchy" {
  "staff_key" bigint [not null]
  "staff_first_name" varchar(50)
  "staff_last_name" varchar(50)
  "manager_key" bigint [not null]
  "manager_first_name" varchar(50)
  "manager_last_name" varchar(50)
  "level" int(5) [not null]

  Indexes {
    (staff_key, manager_key, level) [pk, name: "bridge_staff_hierarchy_PK"]
    staff_key [name: "bridge_staff_hierarchy_staff_IDX"]
    manager_key [name: "bridge_staff_hierarchy_manager_IDX"]
  }
}

Table "bridge_car_equipment" {
  "car_key" bigint [not null]
  "equipment_group_key" bigint [not null]

  Indexes {
    car_key [pk, name: "bridge_car_equipment_PK", unique]
    equipment_group_key [name: "bridge_car_equipment_group_IDX"]
  }
}
Ref "fact_rental_to_dim_customer": "dim_customer"."customer_key" < "fact_rental"."customer_key"
Ref "fact_rental_to_dim_car": "dim_car"."car_key" < "fact_rental"."car_key"
Ref "fact_rental_to_dim_staff": "dim_staff"."staff_key" < "fact_rental"."staff_key"
Ref "fact_rental_to_dim_store": "dim_store"."store_key" < "fact_rental"."store_key"
Ref "fact_rental_to_dim_rental_date": "dim_rental_date"."rental_date_key" < "fact_rental"."rental_date_key"
Ref "fact_rental_to_dim_return_date": "dim_return_date"."return_date_key" < "fact_rental"."return_date_key"
Ref "fact_rental_to_dim_payment_date": "dim_payment_date"."payment_date_key" < "fact_rental"."payment_date_key"
Ref "fact_rental_to_dim_payment_deadline_date": "dim_payment_deadline_date"."payment_deadline_date_key" < "fact_rental"."payment_deadline_date_key"

Ref "fact_service_to_dim_car": "dim_car"."car_key" < "fact_service"."car_key"
Ref "fact_service_to_dim_service_date": "dim_service_date"."service_date_key" < "fact_service"."service_date_key"

Ref "bridge_staff_hierarchy_to_staff": "dim_staff"."staff_key" < "bridge_staff_hierarchy"."staff_key"
Ref "bridge_staff_hierarchy_to_manager": "dim_manager"."manager_key" < "bridge_staff_hierarchy"."manager_key"

Ref "bridge_car_equipment_to_car": "dim_car"."car_key" < "bridge_car_equipment"."car_key"
Ref "bridge_car_equipment_to_group": "bridge_equipment_group_equipment"."equipment_group_key" < "bridge_car_equipment"."equipment_group_key"

Ref "bridge_equipment_group_to_equipment": "dim_equipment"."equipment_key" < "bridge_equipment_group_equipment"."equipment_key"
